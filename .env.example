VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v2-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
VITE_THUMIO_AUTH_KEY=

# Inbox that receives DocVerify notification emails.
# Safe to expose to the browser (it's only a recipient, not a secret).
VITE_RESPONSE_EMAIL=your-email@example.com

# Optional: if the UI is hosted on a different domain than the Vercel API,
# set this to your Vercel app URL (no trailing slash), e.g. https://doc-verify.vercel.app
# VITE_API_BASE=https://your-app.vercel.app

# ─── Resend (transactional email) ───────────────────────────────
# SERVER-ONLY secrets. Do NOT prefix with VITE_ and never read with
# import.meta.env. Set these in the Vercel project settings for production.

# Your Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Verified sender. Until your domain is verified in Resend, use the
# sandbox sender below (it only delivers to your own Resend account email).
# After verifying a domain, switch to e.g. "DocVerify <noreply@yourdomain.com>".
RESEND_FROM=DocVerify <onboarding@resend.dev>

# Optional: override the recipient on the server without exposing it to the
# browser. Falls back to VITE_RESPONSE_EMAIL when unset.
# RESPONSE_EMAIL=your-email@example.com
