{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/send-response.ts": {
      "maxDuration": 15
    },
    "api/send-response-batch.ts": {
      "maxDuration": 15
    },
    "api/verify-captcha.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
